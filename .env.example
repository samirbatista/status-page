# Copie para .env e preencha. Nunca versione o arquivo .env.

# --- Obrigatórios -----------------------------------------------------------
# Use apenas letras e números (vai dentro da URL de conexão): openssl rand -hex 24
POSTGRES_PASSWORD=
# Chave mestra para cifrar segredos em repouso: openssl rand -base64 32
APP_SECRET=
# Conta Dono criada no primeiro start: é a conta de emergência (entra mesmo com o LDAP fora do ar).
SEED_OWNER_EMAIL=admin@example.com
# Mínimo de 12 caracteres.
SEED_OWNER_PASSWORD=

# --- Opcionais --------------------------------------------------------------
SEED_OWNER_NAME=Administrador
# Cria uma página de exemplo com alguns componentes.
SEED_DEMO_PAGE=false
# Domínio público (ex.: status.empresa.com.br) para HTTPS automático.
# Vazio = HTTP na porta 80, adequado para rede interna.
SITE_ADDRESS=
# Endereço público do site, usado nos links das notificações (ex.: https://status.empresa.com.br).
PUBLIC_URL=http://localhost
HTTP_PORT=80
HTTPS_PORT=443
LOG_LEVEL=info
# Intervalo da sincronização com os diretórios LDAP, em minutos (0 desliga).
LDAP_SYNC_MINUTES=15
# Envios de notificação por segundo, somando todos os canais.
NOTIFY_RATE_PER_SECOND=20
# Segundos de cache do resumo das páginas públicas para visitantes anônimos (0 desliga).
PUBLIC_CACHE_SECONDS=5
# Imagens publicadas (GitHub Container Registry). Com IMAGE_PREFIX=status-page, as
# imagens são construídas localmente a partir do código (docker compose build).
IMAGE_PREFIX=ghcr.io/samirbatista/status-page
# Versão instalada (tag da release, ex.: 1.0.1).
IMAGE_TAG=1.0.1

# --- Desenvolvimento local (pnpm dev) ----------------------------------------
# DATABASE_URL=postgresql://status:status@localhost:5432/status
# REDIS_URL=redis://localhost:6379
