// F0: identidade, páginas, componentes, auditoria e configurações.
// F1: incidentes, manutenções e templates de incidente.
// F2: tema visual, uploads, domínios próprios e páginas privadas.
// F3: provedores LDAP, mapeamento de grupos, MFA e conta de emergência.
// Notificações e monitoramento entram nas fases seguintes.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ComponentStatus {
  operational
  under_maintenance
  degraded_performance
  partial_outage
  major_outage
}

enum IncidentStatus {
  investigating
  identified
  monitoring
  resolved
}

enum IncidentImpact {
  none
  minor
  major
  critical
}

enum MaintenanceStatus {
  scheduled
  in_progress
  completed
}

enum PageVisibility {
  public
  private
}

/// Como uma página privada é liberada.
enum PrivateAccessMode {
  login
  ip
  login_or_ip
  login_and_ip
}

enum ThemeKind {
  draft
  published
}

enum UploadKind {
  image
  font
}

enum Role {
  viewer
  operator
  admin
  owner
}

enum IdentityProvider {
  local
  ldap
}

enum LdapKind {
  active_directory
  openldap
}

/// Segurança da conexão LDAP. `none` só é aceito para laboratório.
enum LdapSecurity {
  none
  starttls
  ldaps
}

// ---------------------------------------------------------------------------
// Páginas e componentes
// ---------------------------------------------------------------------------

model Page {
  id            String            @id @default(uuid(7)) @db.Uuid
  slug          String            @unique
  name          String
  description   String?
  defaultLocale String            @default("pt-BR") @map("default_locale")
  timezone      String            @default("America/Sao_Paulo")
  visibility    PageVisibility    @default(public)
  /// Regras de acesso quando `visibility = private`.
  privateAccess PrivateAccessMode @default(login) @map("private_access")
  /// Redes liberadas (CIDR), usadas pelos modos com IP.
  allowedCidrs  String[]          @default([]) @map("allowed_cidrs")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  domains      PageDomain[]
  components   PageComponent[]
  groups       ComponentGroup[]
  roles        UserPageRole[]
  ldapMappings LdapGroupMapping[]
  incidents    Incident[]
  maintenances Maintenance[]
  templates    IncidentTemplate[]
  themes       PageTheme[]
  uploads      Upload[]

  @@map("pages")
}

model PageDomain {
  id                String    @id @default(uuid(7)) @db.Uuid
  pageId            String    @map("page_id") @db.Uuid
  hostname          String    @unique
  /// Valor esperado no registro TXT `_status-page.<hostname>`.
  verificationToken String    @map("verification_token")
  verifiedAt        DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("page_domains")
}

model ComponentGroup {
  id        String   @id @default(uuid(7)) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  name      String
  position  Int      @default(0)
  collapsed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  page       Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  components PageComponent[]

  @@index([pageId, position])
  @@map("component_groups")
}

/// Um componente existe uma única vez e pode ser exibido em várias páginas (PageComponent).
model Component {
  id          String          @id @default(uuid(7)) @db.Uuid
  name        String
  description String?
  status      ComponentStatus @default(operational)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  pages           PageComponent[]
  history         ComponentStatusHistory[]
  incidentUpdates IncidentUpdateComponent[]
  maintenances    MaintenanceComponent[]

  @@map("components")
}

model PageComponent {
  pageId      String  @map("page_id") @db.Uuid
  componentId String  @map("component_id") @db.Uuid
  groupId     String? @map("group_id") @db.Uuid
  position    Int     @default(0)
  showUptime  Boolean @default(true) @map("show_uptime")

  page      Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  component Component       @relation(fields: [componentId], references: [id], onDelete: Cascade)
  group     ComponentGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@id([pageId, componentId])
  @@index([componentId])
  @@index([groupId])
  @@map("page_components")
}

/// Registro de cada mudança de status; base para o cálculo de uptime.
model ComponentStatusHistory {
  id          String          @id @default(uuid(7)) @db.Uuid
  componentId String          @map("component_id") @db.Uuid
  status      ComponentStatus
  changedAt   DateTime        @default(now()) @map("changed_at") @db.Timestamptz(3)
  changedById String?         @map("changed_by_id") @db.Uuid

  component Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  changedBy User?     @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([componentId, changedAt])
  @@map("component_status_history")
}

/// Identidade visual da página: um registro de rascunho e um publicado.
model PageTheme {
  id          String    @id @default(uuid(7)) @db.Uuid
  pageId      String    @map("page_id") @db.Uuid
  kind        ThemeKind
  /// Conteúdo validado pelo `themeSchema` (CSS e HTML já sanitizados).
  data        Json
  updatedById String?   @map("updated_by_id") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, kind])
  @@map("page_themes")
}

/// Arquivo enviado (logo, favicon, fonte). O conteúdo fica no disco, em UPLOAD_DIR/<id>.
model Upload {
  id          String     @id @default(uuid(7)) @db.Uuid
  pageId      String     @map("page_id") @db.Uuid
  kind        UploadKind
  filename    String
  contentType String     @map("content_type")
  size        Int
  sha256      String
  createdById String?    @map("created_by_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
  @@map("uploads")
}

// ---------------------------------------------------------------------------
// Incidentes e manutenções
// ---------------------------------------------------------------------------

model Incident {
  id          String         @id @default(uuid(7)) @db.Uuid
  pageId      String         @map("page_id") @db.Uuid
  title       String
  status      IncidentStatus
  impact      IncidentImpact @default(minor)
  /// Incidente registrado depois do fato; não altera o status atual dos componentes.
  backfilled  Boolean        @default(false)
  startedAt   DateTime       @map("started_at") @db.Timestamptz(3)
  resolvedAt  DateTime?      @map("resolved_at") @db.Timestamptz(3)
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  page      Page             @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  updates   IncidentUpdate[]

  @@index([pageId, status])
  @@index([pageId, startedAt])
  @@map("incidents")
}

model IncidentUpdate {
  id          String         @id @default(uuid(7)) @db.Uuid
  incidentId  String         @map("incident_id") @db.Uuid
  status      IncidentStatus
  body        String
  /// Se os assinantes devem ser notificados (usado a partir da F4).
  notify      Boolean        @default(true)
  /// Momento exibido na linha do tempo (pode ser passado em incidentes retroativos).
  displayAt   DateTime       @map("display_at") @db.Timestamptz(3)
  createdById String?        @map("created_by_id") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  incident   Incident                  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  createdBy  User?                     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  components IncidentUpdateComponent[]

  @@index([incidentId, displayAt])
  @@map("incident_updates")
}

/// Status de cada componente afetado, definido em uma atualização do incidente.
model IncidentUpdateComponent {
  updateId    String          @map("update_id") @db.Uuid
  componentId String          @map("component_id") @db.Uuid
  status      ComponentStatus

  update    IncidentUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  component Component      @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([updateId, componentId])
  @@index([componentId])
  @@map("incident_update_components")
}

model Maintenance {
  id             String            @id @default(uuid(7)) @db.Uuid
  pageId         String            @map("page_id") @db.Uuid
  title          String
  status         MaintenanceStatus @default(scheduled)
  scheduledStart DateTime          @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd   DateTime          @map("scheduled_end") @db.Timestamptz(3)
  /// Inicia e conclui sozinha nos horários agendados.
  autoStart      Boolean           @default(true) @map("auto_start")
  autoComplete   Boolean           @default(true) @map("auto_complete")
  startedAt      DateTime?         @map("started_at") @db.Timestamptz(3)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(3)
  createdById    String?           @map("created_by_id") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  page       Page                   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdBy  User?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  updates    MaintenanceUpdate[]
  components MaintenanceComponent[]

  @@index([status, scheduledStart])
  @@index([pageId, scheduledStart])
  @@map("maintenances")
}

model MaintenanceUpdate {
  id            String            @id @default(uuid(7)) @db.Uuid
  maintenanceId String            @map("maintenance_id") @db.Uuid
  status        MaintenanceStatus
  body          String
  notify        Boolean           @default(true)
  createdById   String?           @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  maintenance Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([maintenanceId, createdAt])
  @@map("maintenance_updates")
}

model MaintenanceComponent {
  maintenanceId  String           @map("maintenance_id") @db.Uuid
  componentId    String           @map("component_id") @db.Uuid
  /// Status do componente no início da manutenção, restaurado ao concluir.
  previousStatus ComponentStatus? @map("previous_status")

  maintenance Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  component   Component   @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([maintenanceId, componentId])
  @@index([componentId])
  @@map("maintenance_components")
}

model IncidentTemplate {
  id              String           @id @default(uuid(7)) @db.Uuid
  pageId          String           @map("page_id") @db.Uuid
  name            String
  title           String
  body            String
  status          IncidentStatus   @default(investigating)
  impact          IncidentImpact   @default(minor)
  componentIds    String[]         @map("component_ids") @db.Uuid
  componentStatus ComponentStatus? @map("component_status")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, name])
  @@map("incident_templates")
}

// ---------------------------------------------------------------------------
// Identidade e acesso
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  name         String
  isOwner      Boolean   @default(false) @map("is_owner")
  /// Conta de emergência: login local sempre permitido, mesmo com LDAP fora do ar.
  isBreakGlass Boolean   @default(false) @map("is_break_glass")
  /// O papel de Dono veio de um mapeamento de grupo LDAP (e é removido se o grupo sair).
  ownerViaLdap Boolean   @default(false) @map("owner_via_ldap")
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(3)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  identities         UserIdentity[]
  pageRoles          UserPageRole[]
  sessions           Session[]
  auditLogs          AuditLog[]
  statusChanges      ComponentStatusHistory[]
  incidents          Incident[]
  incidentUpdates    IncidentUpdate[]
  maintenances       Maintenance[]
  maintenanceUpdates MaintenanceUpdate[]
  totp               TotpSecret?
  webauthn           WebAuthnCredential[]
  recoveryCodes      RecoveryCode[]

  @@map("users")
}

/// Forma de autenticação do usuário. Local guarda o hash argon2id; LDAP guarda o DN.
model UserIdentity {
  id           String           @id @default(uuid(7)) @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  provider     IdentityProvider
  /// Para `local`: o e-mail normalizado. Para `ldap`: `<providerId>:<objectGUID ou DN>`.
  subject      String
  passwordHash String?          @map("password_hash")
  /// Provedor LDAP de origem (somente identidades `ldap`).
  ldapProviderId String?        @map("ldap_provider_id") @db.Uuid
  /// DN atual do usuário no diretório.
  dn           String?
  /// Login usado no diretório (sAMAccountName, uid...).
  username     String?
  /// DNs dos grupos lidos na última sincronização.
  groups       String[]         @default([])
  /// Conta desativada ou removida do diretório: perde o acesso até ser reativada.
  disabledAt   DateTime?        @map("disabled_at") @db.Timestamptz(3)
  lastSyncAt   DateTime?        @map("last_sync_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ldapProvider LdapProvider? @relation(fields: [ldapProviderId], references: [id], onDelete: Cascade)
  sessions     Session[]

  @@unique([provider, subject])
  @@index([userId])
  @@index([ldapProviderId])
  @@map("user_identities")
}

model UserPageRole {
  userId    String   @map("user_id") @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  role      Role
  /// Papel definido manualmente prevalece sobre o mapeado por grupo LDAP.
  manual    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([userId, pageId])
  @@index([pageId])
  @@map("user_page_roles")
}

model Session {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// Hash SHA-256 do token entregue no cookie; o token em si nunca é armazenado.
  tokenHash    String    @unique @map("token_hash")
  ip           String?
  userAgent    String?   @map("user_agent")
  /// O segundo fator foi confirmado nesta sessão.
  mfaVerified  Boolean   @default(false) @map("mfa_verified")
  /// Identidade usada no login (para revogar sessões quando o diretório desativa a conta).
  identityId   String?   @map("identity_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  identity UserIdentity? @relation(fields: [identityId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([identityId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// LDAP e MFA
// ---------------------------------------------------------------------------

model LdapProvider {
  id                String       @id @default(uuid(7)) @db.Uuid
  name              String
  kind              LdapKind
  enabled           Boolean      @default(true)
  /// Ordem em que os provedores são tentados no login.
  position          Int          @default(0)
  host              String
  port              Int
  security          LdapSecurity @default(ldaps)
  /// Valida o certificado do servidor (desligar só em laboratório).
  verifyCertificate Boolean      @default(true) @map("verify_certificate")
  /// CA própria em PEM, para certificados emitidos pela PKI interna.
  caCertificate     String?      @map("ca_certificate")
  bindDn            String       @map("bind_dn")
  /// Senha do bind de serviço, cifrada com AES-256-GCM (APP_SECRET).
  bindPasswordEnc   String       @map("bind_password_enc")
  baseDn            String       @map("base_dn")
  /// Filtro de busca do usuário; `{username}` é substituído pelo login escapado.
  userFilter        String       @map("user_filter")
  usernameAttribute String       @map("username_attribute")
  emailAttribute    String       @map("email_attribute")
  nameAttribute     String       @map("name_attribute")
  /// Identificador estável: objectGUID (AD) ou entryUUID (OpenLDAP).
  uniqueIdAttribute String       @map("unique_id_attribute")
  /// AD: resolve grupos aninhados com LDAP_MATCHING_RULE_IN_CHAIN.
  nestedGroups      Boolean      @default(true) @map("nested_groups")
  /// OpenLDAP: base e filtro da busca de grupos (`{dn}` e `{username}`).
  groupBaseDn       String?      @map("group_base_dn")
  groupFilter       String?      @map("group_filter")
  /// Papel atribuído manualmente prevalece sobre o mapeado por grupo.
  manualRolesWin    Boolean      @default(true) @map("manual_roles_win")
  /// Vincula o login LDAP a um usuário local existente com o mesmo e-mail.
  linkByEmail       Boolean      @default(false) @map("link_by_email")
  timeoutMs         Int          @default(5000) @map("timeout_ms")
  lastSyncAt        DateTime?    @map("last_sync_at") @db.Timestamptz(3)
  lastSyncError     String?      @map("last_sync_error")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  mappings   LdapGroupMapping[]
  identities UserIdentity[]

  @@map("ldap_providers")
}

/// Grupo LDAP → papel. Sem página, o único papel aceito é `owner` (global).
model LdapGroupMapping {
  id         String   @id @default(uuid(7)) @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  /// DN do grupo, normalizado em minúsculas.
  groupDn    String   @map("group_dn")
  pageId     String?  @map("page_id") @db.Uuid
  role       Role
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  provider LdapProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  page     Page?        @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([providerId, groupDn, pageId])
  @@index([pageId])
  @@map("ldap_group_mappings")
}

model TotpSecret {
  userId      String    @id @map("user_id") @db.Uuid
  /// Segredo base32 cifrado com AES-256-GCM.
  secretEnc   String    @map("secret_enc")
  /// Nulo enquanto o cadastro não foi confirmado com um código.
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// Último passo de 30 s aceito, para impedir reuso do mesmo código.
  lastStep    BigInt    @default(0) @map("last_step")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("totp_secrets")
}

model WebAuthnCredential {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// ID da credencial em base64url.
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  /// Domínio (RP ID) em que a credencial foi registrada.
  rpId         String    @map("rp_id")
  name         String
  backedUp     Boolean   @default(false) @map("backed_up")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

/// Códigos de recuperação de uso único, guardados como HMAC-SHA256.
model RecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@map("recovery_codes")
}

// ---------------------------------------------------------------------------
// Sistema
// ---------------------------------------------------------------------------

/// Log de auditoria somente de inclusão.
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  pageId     String?  @map("page_id") @db.Uuid
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([pageId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Configurações globais chave/valor. Valores sensíveis são gravados cifrados.
model Setting {
  key       String   @id
  value     Json
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}
