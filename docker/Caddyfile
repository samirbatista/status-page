{
	admin off
	# Domínios próprios: o certificado é emitido no primeiro acesso, mas só para
	# domínios verificados no painel (a API responde a este "ask").
	on_demand_tls {
		ask http://api:3001/api/internal/tls-ask
	}
}

(app) {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		# Só tem efeito em HTTPS (o navegador ignora em HTTP).
		Strict-Transport-Security "max-age=31536000"
		-Server
		-X-Powered-By
	}

	# Rotas internas (como o "ask" do TLS) nunca ficam expostas.
	handle /api/internal/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}
}

# Domínio principal. SITE_ADDRESS omitido = HTTP na porta 80 (rede interna),
# que também atende domínios próprios por HTTP.
{$SITE_ADDRESS::80} {
	import app
}

# Domínios próprios verificados, com HTTPS automático sob demanda.
https:// {
	tls {
		on_demand
	}
	import app
}
