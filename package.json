{
  "name": "status-page",
  "version": "1.0.1",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @status-page/db generate",
    "db:migrate": "pnpm --filter @status-page/db migrate:dev",
    "db:deploy": "pnpm --filter @status-page/db migrate:deploy",
    "db:seed": "pnpm --filter @status-page/db seed",
    "infra:up": "docker compose -f compose.dev.yaml up -d",
    "infra:down": "docker compose -f compose.dev.yaml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
